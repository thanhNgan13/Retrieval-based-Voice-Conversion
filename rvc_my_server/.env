# ---- App ----
ENV_PREFIX=dev
API_VERSION=v1
PORT=8000

# ---- JWT ----
JWT_SECRET=replace_with_a_long_random_string
REFRESH_TOKEN_SECRET=replace_with_another_long_random_string
ADMIN_JWT_SECRET=replace_with_admin_secret
ADMIN_REFRESH_TOKEN_SECRET=replace_with_admin_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d

# ---- Admin (login mặc định, đổi trước khi deploy production) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---- Firebase ----
# Path to the service account JSON file (download from Firebase console)
GOOGLE_APPLICATION_CREDENTIALS=./src/config/serviceAccount.json
FIREBASE_PROJECT_ID=project-76a03092-ce94-4b17-94f
FIREBASE_STORAGE_BUCKET=project-76a03092-ce94-4b17-94f.firebasestorage.app

# ---- Firestore emulator (optional, for local) ----
# FIRESTORE_EMULATOR_HOST=localhost:8080
# STORAGE_EMULATOR_HOST=http://localhost:9199

# ---- Infer (RVC) ----
# Thư mục chứa hubert_base.pt, rmvpe.pt — tải qua POST /admin-services/setup-assets
ASSETS_DIR=./assets
# Cache local cho file .pth/.index per rvcModelId + output infer
INFER_CACHE_DIR=./cache

# ---- Training queue / realtime progress ----
REDIS_URL=redis://localhost:6379/0
# Nếu để trống sẽ dùng REDIS_URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
TRAIN_CACHE_DIR=./cache/train_jobs
SIGNED_UPLOAD_URL_EXPIRES_SECONDS=3600
SIGNED_DOWNLOAD_URL_EXPIRES_SECONDS=3600

# ---- Resource-aware job scheduler (Tesla P4 - 7680 MB) ----
TRAIN_JOB_VRAM_MB=4096
INFER_JOB_VRAM_MB=3072
FALLBACK_TOTAL_VRAM_MB=7680
SCHEDULER_INTERVAL_SECONDS=3.0
CELERY_WORKER_CONCURRENCY=4
